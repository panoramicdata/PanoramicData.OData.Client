<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <!-- NuGet Package Metadata -->
  <PropertyGroup>
    <PackageId>PanoramicData.OData.Client</PackageId>
    <Description>A lightweight, modern OData V4 client library for .NET. Features include LINQ-like query builder, full CRUD support, automatic pagination, retry logic, and ILogger integration.</Description>
    <PackageTags>OData;OData4;Client;REST;API;HTTP;LINQ;Query;Pagination</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/panoramicdata/PanoramicData.OData.Client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/panoramicdata/PanoramicData.OData.Client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>
      Security fix: credential-bearing HTTP header values are now redacted in diagnostic output.

      Previously caller-supplied header values were written verbatim in two places: one Debug line
      per header as it was added to a request, and the Trace request and response dumps. Any
      credential attached to a query was therefore retained for the life of the consumer log store.

      Note the Debug path, which fires a level higher than the Trace dumps, so a consumer running at
      Debug rather than Trace was still affected.

      This client applies no credential of its own, so redaction matches a general set of header
      names plus name fragments rather than a scheme this library controls. The authentication
      scheme and the credential length are retained, so requests remain diagnosable.

      Request rendering that forms part of the wire format, such as the batch payload built by
      HttpMessageContent, is deliberately unchanged. Redacting there would corrupt the request.

      Consumers should upgrade and then review existing Debug and Trace logs for previously
      captured credentials.

      Initial release with OData V4 support, query builder, CRUD operations, pagination, retry
      logic, and logging.
    </PackageReleaseNotes>
  </PropertyGroup>
  <!-- SourceLink for debugging -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PanoramicData.OData.Client.Test" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
    <None Include="Panoramic Data.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>